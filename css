body{
background:#0f172a;
color:white;
font-family:Arial, sans-serif;
text-align:center;
padding:20px;
}
 
h1{
margin-bottom:30px;
}
 
.stats{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:15px;
}
 
.card{
background:#1e293b;
padding:20px;
margin:10px auto;
max-width:500px;
border-radius:15px;
}
 
button{
padding:10px 15px;
margin:5px;
border:none;
border-radius:10px;
cursor:pointer;
font-weight:bold;
}
 
.buttons{
margin:20px;
}
 
.next-turn{
background:gold;
color:black;
font-size:18px;
}
